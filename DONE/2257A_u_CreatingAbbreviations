#include <algorithm>
#include <cctype>
#include <iostream>
#include <map>
#include <set>
#include <string>
#include <unordered_set>
#include <utility>
#include <vector>

int main()
{
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(NULL);

    int nb_cases;
    std::cin >> nb_cases;
    while (nb_cases--)
    {
        int n, m;
        std::cin >> n >> m;

        std::unordered_set<char> lettres;

        for (int i = 0; i < n; i++)
        {
            std::string mot;
            std::cin >> mot;
            char lettre = mot[0];
            lettres.insert(toupper(lettre));
        }

        bool valid = true;
        for (int i = 0; i < m; i++)
        {
            std::string mot;
            std::cin >> mot;
            for (char lettre : mot)
            {
                if (lettres.find(lettre) == lettres.end())
                {
                    valid = false;
                    break;
                }
            }
        }
        if (valid)
            std::cout << "YES" << "\n";
        else
        {
            std::cout << "NO" << "\n";
            valid = true;
        }
    }
}
